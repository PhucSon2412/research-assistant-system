# Copy to .env (git-ignored) and replace every empty value with your own
# random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
# Compose refuses to start while a required value is unset.

POSTGRES_USER=ras
POSTGRES_DB=ras
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=ras-minio
MINIO_ROOT_PASSWORD=

# Optional host port overrides (all bound to 127.0.0.1).
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=8000
# WEB_HOST_PORT=3000
# MINIO_CONSOLE_HOST_PORT=9001
