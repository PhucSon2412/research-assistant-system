# Copy to .env (git-ignored) and replace every empty value with your own
# random secret; see docs/dev-setup.md for the generator command per shell.
# Compose refuses to start while a required value is unset.
# Wrap a value in single quotes if it contains $, # or spaces, e.g.
# POSTGRES_PASSWORD='...' -- single quotes disable Compose's variable
# interpolation and inline-comment parsing; the value itself must not contain
# a single quote. URL delimiters such as @ : / ? % need no escaping: the app
# passes connection parts separately and never splices them into a URL.

POSTGRES_USER=ras
POSTGRES_DB=ras
POSTGRES_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=ras-minio
MINIO_ROOT_PASSWORD=

# Optional for M3a indexing. Keep this secret only in .env or a secret manager.
# OPENROUTER_API_KEY=
# After a synthetic live route/usage/price probe, set these for the worker:
# RAS_EMBEDDING__PRICING_VERIFIED=true
# RAS_EMBEDDING__MAX_USD_PER_MILLION_TOKENS=0.10
# RAS_BUDGET__EMBEDDING_WARNING_FRACTION=0.8
# RAS_BUDGET__USER_EMBEDDING_DAILY_USD=1.0
# RAS_BUDGET__USER_EMBEDDING_WARNING_FRACTION=0.8
# For M3b API hybrid/rerank, verify the live route, key charge and provider
# first. The rerank listed price is only a configured estimate until then.
# RAS_RERANK__PRICING_VERIFIED=true
# RAS_RERANK__MAX_USD_PER_MILLION_TOKENS=0.20

# Optional host port overrides (all bound to 127.0.0.1).
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=8000
# WEB_HOST_PORT=3000
# MINIO_CONSOLE_HOST_PORT=9001
# MINIO_API_HOST_PORT=9000
