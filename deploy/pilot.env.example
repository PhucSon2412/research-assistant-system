# M8a pilot deployment env file (template). Copy OUTSIDE the repo, fill every
# empty value with an operator-generated secret/value, and pass it with
#   docker compose --env-file <copy> -p <project> -f deploy/compose.yaml ...
# Never commit the filled copy. Example values below are placeholders; no real
# domain, host or SMTP account has been assigned to this project yet.

RAS_DEPLOY_PROJECT=ras-pilot
# Frozen images built from the reviewed commit (record the digests).
RAS_API_IMAGE=ras-pilot-api:<commit>
RAS_WEB_IMAGE=ras-pilot-web:<commit>

# Public HTTPS host. Without a tls.d snippet Caddy requests a public ACME
# certificate for it, which needs real DNS and reachable ports 80/443.
RAS_PUBLIC_HOST=ras.example.org
RAS_EDGE_BIND=0.0.0.0
RAS_EDGE_HTTP_PORT=80
RAS_EDGE_HTTPS_PORT=443
# Starting value for a pilot whose domain may still change; raise after cutover.
RAS_HSTS_MAX_AGE=86400
# RAS_CADDY_TLS_DIR=./caddy/tls.d

# Backend network and web's fixed address in it: the API trusts the client
# address header from exactly this address (/32). Pick a subnet unused on the host.
RAS_BACKEND_SUBNET=172.31.240.0/24
RAS_WEB_BACKEND_IP=172.31.240.10

# Directory with files edge_token, rate_limit_key, smtp_password (see runbook).
RAS_SECRETS_DIR=/srv/ras-pilot/secrets
# Revocation journal directory: explicit, outside DB/object volumes and their
# backups. On the same machine it does NOT give an independent failure domain.
RAS_JOURNAL_DIR=/srv/ras-pilot/journal
# M8b operations (docs/m8b-pilot-operations.md). Ops image = API image + pyrage,
# built with: docker compose ... --profile ops build ops
RAS_OPS_IMAGE=ras-pilot-ops:<commit>
# ops.json + age recipient public key(s); never a private key (refused).
RAS_OPS_CONFIG_DIR=/srv/ras-pilot/ops-config
# State shared by the replicator, the check and scripts/ras_ops.py (UID 10001 rw).
RAS_OPS_STATE_DIR=/srv/ras-pilot/ops-state
# Plaintext backup work only; mode 0700, UID 10001; emptied after each run.
RAS_OPS_STAGING_DIR=/srv/ras-pilot/staging
# The edge answers 503 "maintenance" while <dir>/enabled exists (read-only mount).
RAS_MAINTENANCE_DIR=/srv/ras-pilot/maintenance
# RAS_SECRETS_DIR also holds, for M8b: journal_replica_credentials,
# journal_replica_read_credentials, backup_target_credentials,
# backup_target_read_credentials (JSON {"access_key_id","secret_access_key"}).

# Optional private relay CA bundle directory, mounted at /etc/ras/trust.
# RAS_TRUST_DIR=./trust

# C4 roles: migrator (owner), runtime, recovery, definer (NOLOGIN).
POSTGRES_USER=ras_migrator
POSTGRES_DB=ras
POSTGRES_PASSWORD=
RAS_RUNTIME_DB_USER=ras_runtime
RAS_RUNTIME_DB_PASSWORD=
RAS_RECOVERY_DB_USER=ras_recovery
RAS_RECOVERY_DB_PASSWORD=
RAS_DEFINER_DB_ROLE=ras_definer
REDIS_PASSWORD=
MINIO_ROOT_USER=ras-minio
MINIO_ROOT_PASSWORD=

# SMTP relay over verified TLS: implicit_tls (SMTPS, often 465) or starttls
# (often 587, refused when not offered). No plaintext or unverified mode exists.
RAS_SMTP_HOST=smtp.example.org
RAS_SMTP_PORT=465
RAS_SMTP_SECURITY=implicit_tls
RAS_SMTP_SENDER=no-reply@ras.example.org
RAS_SMTP_SENDER_NAME=Research Assistant System
# With AUTH: set the user and RAS_SMTP_PASSWORD_FILE=/run/secrets/smtp_password.
RAS_SMTP_USERNAME=
RAS_SMTP_PASSWORD_FILE=
# Empty = the image's system CAs; a private CA file lives under RAS_TRUST_DIR:
# RAS_SMTP_CA_FILE=/etc/ras/trust/relay-ca.pem
RAS_SMTP_CA_FILE=
RAS_SMTP_CONNECT_TIMEOUT_SECONDS=5
RAS_SMTP_TOTAL_TIMEOUT_SECONDS=10

# Provider stays off for the pilot entry: empty key, pricing false.
OPENROUTER_API_KEY=
RAS_EMBEDDING__PRICING_VERIFIED=false
RAS_RERANK__PRICING_VERIFIED=false
RAS_GENERATION__PRICING_VERIFIED=false
RAS_DISCOVERY__ENABLED=false
